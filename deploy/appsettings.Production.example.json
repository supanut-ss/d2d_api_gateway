{
  "Server": {
    "PublicBaseUrl": "https://api.example.com"
  },
  "MasterDb": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=<host>;Database=<d2d_master>;User Id=<user>;Password=<password>;TrustServerCertificate=True",
    "AutoCreate": true
  },
  "Jwt": {
    "Issuer": "https://api.example.com",
    "Audience": "d2d-apps",
    "PrivateKeyPath": "C:\\inetpub\\vhosts\\example.com\\private\\d2d\\jwt-signing.pem"
  },
  "Line": {
    "LoginCallbackUrl": "https://api.example.com/api/v1/auth/line/callback"
  },
  "Admin": {
    "ApiKey": "<long random string>"
  },
  "DataProtection": {
    "KeysPath": "C:\\inetpub\\vhosts\\example.com\\private\\d2d\\keys",
    "ProtectWithDpapi": true
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.example.com" ]
  }
}
